GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
BATCH_SIZE=50
MAX_WORKERS=1
# Free-tier RPM limits shown for the configured models; adjust if your project tier changes.
GEMINI_FAST_RPM=15
GEMINI_STRONG_RPM=5
# Standard paid-tier list prices per 1M tokens. The app calls the Standard endpoint.
MODEL_FAST_INPUT_USD_PER_1M=0.30
MODEL_FAST_OUTPUT_USD_PER_1M=2.50
MODEL_STRONG_INPUT_USD_PER_1M=1.50
MODEL_STRONG_OUTPUT_USD_PER_1M=9.00
